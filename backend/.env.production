# Production Environment Variables Template
# Copy this to .env and configure for your server

# Server Port
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=fekusa
DB_PASSWORD=putri123
DB_NAME=postgres
DB_CONTAINER=postgres17

# JWT Secret for Authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_IN_PRODUCTION

# RSS Fetch Interval (minutes)
FETCH_INTERVAL=15

# CORS Origin (allow multiple origins, comma separated)
CORS_ORIGIN=https://x.papua.news,http://x.papua.news,https://api-rss.papua.news

# ==========================================
# IMPORTANT - Checklist untuk Production:
# ==========================================
# 1. Ganti DB_USER dan DB_PASSWORD dengan credentials PostgreSQL di server
# 2. Pastikan PostgreSQL running: systemctl status postgresql (atau docker ps)
# 3. Test koneksi: psql -U fekusa -d postgres -h localhost
# 4. Import database: psql -U fekusa -d postgres < exports/full_backup.sql
# 5. Restart backend: pm2 restart all (atau node server.js)
# 6. Test API: curl http://localhost:4000/health
# 7. Check logs: pm2 logs rss-backend
