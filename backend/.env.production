# Production Environment Variables Template
# Copy this to .env and configure for your server

# Server Port
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=postgres

# RSS Fetch Interval (minutes)
FETCH_INTERVAL=15

# CORS Origin (allow multiple origins, comma separated)
CORS_ORIGIN=https://rss.fekusadev.com,https://api-rss.fekusadev.com

# ==========================================
# IMPORTANT - Checklist untuk Production:
# ==========================================
# 1. Ganti DB_USER dan DB_PASSWORD dengan credentials PostgreSQL di server
# 2. Pastikan PostgreSQL running: systemctl status postgresql (atau docker ps)
# 3. Test koneksi: psql -U your_db_username -d postgres -h localhost
# 4. Import database: psql -U your_db_username -d postgres < exports/import_all_complete.sql
# 5. Restart backend: pm2 restart all (atau node server.js)
